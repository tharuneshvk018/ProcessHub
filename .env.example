# ==============================================================================
# ProcessHub Enterprise - Environment Configuration Template
# ==============================================================================
# Copy this template to .env before deploying:
#   cp .env.example .env

# --- Database Configuration (PostgreSQL 16) ---
POSTGRES_DB=processhub
POSTGRES_USER=processhub
POSTGRES_PASSWORD=replace_with_strong_production_password
DB_PORT=5432

# --- Backend Application Configuration (Spring Boot 3) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT Authentication Secret (Must be 256-bit / 32+ byte hex or base64 key in production)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# File Storage Configuration
APP_STORAGE_UPLOAD_DIR=/app/uploads

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# --- Frontend Web Application (React + Nginx) ---
FRONTEND_PORT=3000
